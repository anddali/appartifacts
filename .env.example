# --- Required ---
# Portal origin (UI, API, OAuth, MCP). Must be https in production.
APPHOST_PUBLIC_URL=https://apphost.corp.example
# Artifacts are served from https://<artifact-id>.<APPHOST_CONTENT_DOMAIN>.
# Use a SEPARATE registrable domain from the portal (e.g. corp-usercontent.example), so artifact
# JavaScript can never read or set portal cookies. Needs a wildcard DNS record and certificate.
APPHOST_CONTENT_DOMAIN=apphost-usercontent.corp.example
DATABASE_URL=postgres://apphost:password@db.internal:5432/apphost
# At least 32 random characters; signs content sessions and hand-off tokens. Rotate = everyone re-opens pages.
APPHOST_SECRET=

# --- Microsoft Entra ID SSO ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- Storage ---
APPHOST_STORAGE=s3
APPHOST_S3_BUCKET=corp-apphost-artifacts
APPHOST_S3_PREFIX=
# AWS_REGION=eu-west-1        # credentials come from the ECS task role

# --- Optional ---
# APPHOST_BIND=0.0.0.0:8080
# APPHOST_SESSION_HOURS=12
# APPHOST_MAX_PUBLISH_MB=100
# APPHOST_LOG_JSON=true
# RUST_LOG=apphost=info,tower_http=info
# Extra sources allowed in artifact pages' Content-Security-Policy (space separated):
# APPHOST_CSP_SCRIPT_SRC=https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://unpkg.com
# APPHOST_CSP_STYLE_SRC=...
# APPHOST_CSP_FONT_SRC=...
# APPHOST_CSP_IMG_SRC=https://intranet-images.corp.example
# APPHOST_CSP_CONNECT_SRC=
# Redirect URIs MCP clients may register for OAuth (comma separated; an entry without a port allows any port):
# APPHOST_OAUTH_REDIRECT_ALLOWLIST=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost/,http://127.0.0.1/

# --- Local development only ---
# APPHOST_DEV_LOGIN=true      # sign in as any email without a password; refuses to start without Entra otherwise
# APPHOST_STORAGE=fs
# APPHOST_FS_ROOT=./data
